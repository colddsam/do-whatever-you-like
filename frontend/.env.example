# Server-only. The browser never sees these; requests go through /api/tools/*.
BACKEND_URL=http://127.0.0.1:8000
# Must match HEADER_TOKEN in backend/.env
BACKEND_TOKEN=
# Production only (e.g. Vercel + Render): the backend's public address. When set, the browser sends
# files straight to the backend with a short-lived signed ticket, because Vercel caps a request
# through a route at 4.5 MB and 300 s. Leave unset locally; files then go through /api/tools/*.
BACKEND_PUBLIC_URL=

# Optional: search engine ownership tags, read at build time. Paste only the content="…" value.
# Google Search Console → Add property → URL prefix → HTML tag. Skip if you verify by DNS.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Add site → HTML meta tag (msvalidate.01). Or import from Search Console.
BING_SITE_VERIFICATION=

# Optional: Google Analytics 4 Measurement ID (defaults to G-GVKMN99S3N if unset; set empty to disable).
NEXT_PUBLIC_GA_ID=

# Optional free email delivery for "Request a tool" -> colddsam@gmail.com (runs right on Vercel with zero cold-start delay).
# Pick ANY ONE free option below (otherwise requests forward to the backend).
# 1. Resend (3,000 free emails/mo):
RESEND_API_KEY=
# 2. Brevo (300 free emails/day):
# BREVO_API_KEY=
# 3. Web3Forms (250 free/mo):
# WEB3FORMS_ACCESS_KEY=
# 4. Gmail App Password via SMTP (Vercel allows outbound 465/587; Render Free blocks SMTP):
# GMAIL_USER=colddsam@gmail.com
# GMAIL_APP_PASSWORD=
# 5. Google Apps Script Web App URL (HTTPS, 100/day free via GmailApp/MailApp):
# TOOL_REQUEST_APPS_SCRIPT_URL=
